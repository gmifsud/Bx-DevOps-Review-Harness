{
  "name": "Bx-Devops-Review-Harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --host 0.0.0.0",
    "electron:dev": "vite build && esbuild main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/main.cjs && esbuild preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/preload.cjs && electron dist/main.cjs",
    "build": "vite build && esbuild main.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/main.cjs && esbuild preload.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/preload.cjs",
    "start": "electron dist/main.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "azure-devops-node-api": "^15.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.1.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  }
}
